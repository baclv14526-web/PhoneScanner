<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="6dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon chevron thu gọn/mở rộng -->
    <TextView
        android:id="@+id/tvChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:gravity="center"
        android:text="▾"
        android:textColor="#8800E5FF"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nhãn ngày -->
    <TextView
        android:id="@+id/tvDayLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#CC00E5FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvChevron"
        app:layout_constraintEnd_toStartOf="@id/tvCount" />

    <!-- Số mục trong ngày -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4400E5FF"
        android:textSize="11sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
